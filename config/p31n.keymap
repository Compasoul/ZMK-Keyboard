#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

// 定义层级别名
#define L0 0
#define L1 1
#define L2 2
#define L3 3
#define L4 4
#define L5 5

/ {
    keymap {
        compatible = "zmk,keymap";

        // =================================================================================
        // L0: DEFAULT LAYER (根据最新图纸精准微调：左下角 Ctrl/，大拇指 LT2,V 与 LT1,SPACE)
        // =================================================================================
        default_layer {
            bindings = <
&kp Q           &lt 3 W      &lt 4 E      &kp R        &kp T        &none          &kp Y          &kp U        &lt 4 I      &lt 3 O         &kp P
&mt LSHFT A     &kp S        &kp D        &kp F        &kp G        &none          &mt RSHFT H    &kp J        &kp K        &kp L           &kp RET
&mt LCTRL FSLH  &mt LGUI Z   &mt LALT X   &kp C        &lt 2 V      &lt 1 SPACE    &lt 2 B        &kp N        &mt RALT M   &mt RGUI COMMA  &mt RCTRL DOT
            >;
        };

        // =================================================================================
        // L1: fn1_layer (数字与基础符号层)
        // =================================================================================
        fn1_layer {
            bindings = <
&kp ESC         &none        &none        &none        &kp BSPC     &none          &kp MINUS      &kp EQUAL    &kp COLON    &kp SQT         &kp BSPC
&kp N1          &kp N2       &kp N3       &kp N4       &kp N5       &none          &kp N6         &kp N7       &kp N8       &kp N9          &kp N0
&kp BSLH        &none        &none        &none        &none        &trans         &none          &none        &none        &kp LBKT        &kp RBKT  
            >;
        };

        // =================================================================================
        // L2: fn2_layer (上档符号与导航层)
        // =================================================================================
        fn2_layer {
            bindings = <
&kp TAB         &none        &none        &none        &kp DEL      &none          &kp UNDER      &kp PLUS     &kp COLON    &kp DQT         &kp DEL
&kp EXCL        &kp AT       &kp HASH     &kp DLLR     &kp PRCNT    &none          &kp CARET      &kp AMPS     &kp STAR     &kp LPAR        &kp RPAR
&kp PIPE        &none        &none        &none        &trans       &none          &trans         &none        &none        &kp LBRC        &kp RBRC
            >;
        };

        // =================================================================================
        // L3: fn3_layer (系统蓝牙与媒体控制)
        // =================================================================================
        fn3_layer {
            bindings = <
&kp ESC         &trans       &none        &none        &none        &none          &none          &none        &none        &trans          &kp BSPC
&none           &none        &none        &none        &none        &none          &none          &none        &none        &kp UP          &none
&none           &none        &none        &none        &none        &none          &none          &none        &kp LEFT     &kp DOWN        &kp RIGHT
            >;
        };
        
        // =================================================================================
        // L4: fn4_layer (三键全高难度组合宏快捷键层)
        // =================================================================================
        fn4_layer {
            bindings = <
&kp TAB         &none        &trans       &none        &none        &none          &none          &none        &trans       &none           &kp DEL
&none           &none        &none        &mo 5        &none        &none          &none          &none        &none        &kp PG_UP       &none
&none           &none        &none        &mkp MB1     &mkp MB2     &mkp MB3       &mkp MB1       &mkp MB2     &kp HOME     &kp PG_DN       &kp END
            >;
        };

        // =================================================================================
        // L5: fn5_layer (双键组合宏与刷机底层)
        // =================================================================================
        fn5_layer {
            bindings = <
&bt BT_CLR      &none        &none        &none        &none        &none          &bt BT_SEL 0   &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3    &bt BT_SEL 4
&none           &none        &none        &trans       &none        &none          &none          &none        &none        &none           &out OUT_BLE
&none           &none        &none        &none        &none        &bootloader    &none          &none        &none        &none           &out OUT_USB 
            >;
        };
    };
};
